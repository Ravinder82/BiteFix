{
  "expo": {
    "name": "BiteFix: Scan.Audit.EatClean",
    "slug": "bitefix",
    "scheme": "bitefix",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ravinderpoonia.bitefix",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "BiteFix",
        "NSCameraUsageDescription": "BiteFix needs access to the camera to scan food barcodes and analyze scores.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ravinderpoonia.bitefix",
      "adaptiveIcon": {
        "backgroundColor": "#faf8f5",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "BiteFix needs access to your camera to scan food barcodes and analyse their content.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1097829102652-jgmhd81kr0c36338ci9tlmh1n3milght"
        }
      ],
      "expo-apple-authentication",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d2c28dd-a8d8-4820-a8c6-fa041e38c4a7"
      }
    },
    "owner": "sonu1294"
  }
}