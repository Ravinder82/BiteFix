{
  "expo": {
    "name": "BiteFix: Food & Swap Scanner",
    "slug": "bitefix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ravinderpoonia.bitefix",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "BiteFix",
        "NSCameraUsageDescription": "BiteFix needs access to the camera to scan food barcodes and analyze scores.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ravinderpoonia.bitefix",
      "adaptiveIcon": {
        "backgroundColor": "#faf8f5",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "BiteFix needs access to your camera to scan food barcodes and analyse their content.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1097829102652-j3ckq63u4imagolthtov6gvl5i2rpqof"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4897c47-87a9-490d-a122-a32feba96484"
      }
    },
    "owner": "ravindrapoonia"
  }
}
