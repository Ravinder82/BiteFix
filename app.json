{
  "expo": {
    "name": "CutSugar: Scan Teaspoons & Log",
    "slug": "cutsugar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ravinderpoonia.cutsugar",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "CutSugar needs access to the camera to scan food barcodes and analyze sugar values."
      }
    },
    "android": {
      "package": "com.ravinderpoonia.cutsugar",
      "adaptiveIcon": {
        "backgroundColor": "#faf8f5",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "CutSugar needs access to your camera to scan food barcodes and analyse their sugar content.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font"
    ]
  }
}
