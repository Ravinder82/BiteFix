{
  "expo": {
    "name": "CutSugar: Sugar Teaspoons Scanner",
    "slug": "cutsugar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ravinderpoonia.cutsugar",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "CutSugar needs access to the camera to scan food barcodes and analyze sugar values."
      }
    },
    "android": {
      "package": "com.ravinderpoonia.cutsugar",
      "adaptiveIcon": {
        "backgroundColor": "#faf8f5",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "CutSugar needs access to your camera to scan food barcodes and analyse their sugar content.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1097829102652-ru6prpd4kgv621fnni74eg3q2n2eh859"
        }
      ],
      "expo-apple-authentication"
    ]
  }
}
